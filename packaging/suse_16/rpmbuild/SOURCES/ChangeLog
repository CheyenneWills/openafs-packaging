            register struct rx_call *z_call;
            struct _index_t * descr;
            char * group, **spool;
    {
    [...]
    after patch:
    int StartDMV_Store(z_call, descr, group)
            register struct rx_call *z_call;
            struct _index_t * descr;
            char * group;
    {
    [...]
    "

